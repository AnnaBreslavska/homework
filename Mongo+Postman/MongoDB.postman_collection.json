      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 201) {\r",
              "    const jsonData = pm.response.json();\r",
              "    const docId = jsonData._id;\r",
              "\r",
              "    pm.collectionVariables.set(\"docId\", docId);\r",
              "    pm.collectionVariables.set(\"jsonDataVariable\", JSON.stringify(jsonData));\r",
              "\r",
              "\r",
              "    const requestBody = pm.request.body.raw;\r",
              "    const requestBodyJson = JSON.parse(requestBody);\r",
              "\r",
              "    pm.collectionVariables.set(\"requestBody\", JSON.stringify(requestBodyJson));\r",
              "\r",
              "    const fields = [\r",
              "        \"name\",\r",
              "        \"summary\",\r",
              "        \"description\",\r",
              "        \"accommodates\",\r",
              "        \"bedrooms\",\r",
              "        \"beds\",\r",
              "        \"bathrooms\",\r",
              "        \"price\",\r",
              "        \"property_type\",\r",
              "        \"room_type\"\r",
              "    ];\r",
              "\r",
              "    fields.forEach(field => {\r",
              "        pm.test(`Field ${field} saved correctly`, function () {\r",
              "            pm.expect(jsonData[field]).to.eql(requestBodyJson[field]);\r",
              "        });\r",
              "    });\r",
              "\r",
              "} else {\r",
              "    pm.test(\"Something went wrong: Status is NOT 201\", function () {\r",
              "        pm.expect(pm.response.code).to.eql(201);\r",
              "    });\r",
              "}\r",
              "\r",
              ""
            ],
