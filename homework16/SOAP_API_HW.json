        {
          "name": "Is Valid ISBN13 Number",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "let isbnLibraryList13 = JSON.parse(pm.collectionVariables.get(\"isbnLibraryList13\"));",
                  "let index = Number(pm.collectionVariables.get(\"index\"));",
                  "let currentISBN = isbnLibraryList13[index];",
                  "",
                  "if (pm.response.code === 500) {",
                  "    pm.test(\"Server returned 500, skipping iteration\", function () {",
                  "        pm.expect(pm.response.code).to.not.eql(500);",
                  "    });",
                  "    index++;",
                  "    pm.collectionVariables.set(\"index\", index);",
                  "    pm.collectionVariables.set(\"currentISBN\", isbnLibraryList13[index]);",
                  "    pm.execution.setNextRequest(\"Is Valid ISBN13 Number\");",
                  "",
                  "} else {",
                  "",
                  "    var jsonObject = xml2Json(responseBody);",
                  "    const headers = pm.response.headers;",
                  "",
                  "    pm.test(\"SOAP response has valid Response Body\", function () {",
                  "        pm.expect(jsonObject).to.have.property(\"soap:Envelope\");",
                  "        pm.expect(jsonObject[\"soap:Envelope\"]).to.have.property(\"soap:Body\");",
                  "        pm.expect(jsonObject[\"soap:Envelope\"][\"soap:Body\"]).to.have.property(\"m:IsValidISBN13Response\");",
                  "        pm.expect(jsonObject[\"soap:Envelope\"][\"soap:Body\"][\"m:IsValidISBN13Response\"]).to.have.property(\"m:IsValidISBN13Result\");",
                  "    });",
                  "",
                  "    const result = jsonObject[\"soap:Envelope\"][\"soap:Body\"][\"m:IsValidISBN13Response\"][\"m:IsValidISBN13Result\"];",
                  "",
                  "    if (result === \"true\") {",
                  "        pm.test(\"Required SOAP headers are present for ISBN 13: \" + currentISBN, function () {",
                  "            pm.expect(headers.has(\"Cache-Control\")).to.be.true;",
                  "            pm.expect(headers.has(\"Content-Type\")).to.be.true;",
                  "            pm.expect(headers.has(\"Content-Encoding\")).to.be.true;",
                  "            pm.expect(headers.has(\"Vary\")).to.be.true;",
                  "            pm.expect(headers.has(\"Server\")).to.be.true;",
                  "            pm.expect(headers.has(\"Web-Service\")).to.be.true;",
                  "            pm.expect(headers.has(\"Permissions-Policy\")).to.be.true;",
                  "            pm.expect(headers.has(\"Strict-Transport-Security\")).to.be.true;",
                  "            pm.expect(headers.has(\"Referrer-Policy\")).to.be.true;",
                  "            pm.expect(headers.has(\"content-security-policy\")).to.be.true;",
                  "            pm.expect(headers.has(\"Date\")).to.be.true;",
                  "            pm.expect(headers.has(\"Content-Length\")).to.be.true;",
                  "        });",
                  "        pm.test(\"Header has valid value for ISBN13: \" + currentISBN, function () {",
                  "            const cacheControl = pm.response.headers.get(\"Cache-Control\");",
                  "            pm.expect(cacheControl).to.include(\"private, max-age=0\");",
                  "            const contentType = pm.response.headers.get(\"Content-Type\");",
                  "            pm.expect(contentType).to.include(\"text/xml\");",
                  "            const contentEncoding = pm.response.headers.get(\"Content-Encoding\");",
                  "            pm.expect(contentEncoding).to.include(\"gzip\");",
                  "            const vary = pm.response.headers.get(\"Vary\");",
                  "            pm.expect(vary).to.include(\"Accept-Encoding\");",
                  "            const server = pm.response.headers.get(\"Server\");",
                  "            pm.expect(server).to.include(\"Microsoft-IIS/10.0\");",
                  "            const webService = pm.response.headers.get(\"Web-Service\");",
                  "            pm.expect(webService).to.include(\"DataFlex 18.2\");",
                  "            const permissionsPolicy = pm.response.headers.get(\"Permissions-Policy\");",
                  "            pm.expect(permissionsPolicy).to.include(\"interest-cohort=()\");",
                  "            const strictTransportSecurity = pm.response.headers.get(\"Strict-Transport-Security\");",
                  "            pm.expect(strictTransportSecurity).to.include(\"max-age=15768000;includeSubdomains\");",
                  "            const referrerPolicy = pm.response.headers.get(\"Referrer-Policy\");",
                  "            pm.expect(referrerPolicy).to.include(\"strict-origin-when-cross-origin\");",
                  "            const contentSecurityPolicy = pm.response.headers.get(\"content-security-policy\");",
                  "            pm.expect(contentSecurityPolicy).to.include(\"default-src\");",
                  "            const date = pm.response.headers.get(\"Date\");",
                  "            pm.expect(date).to.match(/^[A-Z][a-z]{2}, \\d{2} [A-Z][a-z]{2} \\d{4} \\d{2}:\\d{2}:\\d{2} GMT$/);",
                  "            const contentLength = pm.response.headers.get(\"Content-Length\");",
                  "            pm.expect(contentLength).to.eql(\"302\");",
                  "        });",
                  "    } else {",
                  "        pm.test(\"Required SOAP headers are present for ISBN 13: \" + currentISBN, function () {",
