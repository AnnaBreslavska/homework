                  "            const strictTransportSecurity = pm.response.headers.get(\"Strict-Transport-Security\");",
                  "            pm.expect(strictTransportSecurity).to.include(\"max-age=15768000;includeSubdomains\");",
                  "            const referrerPolicy = pm.response.headers.get(\"Referrer-Policy\");",
                  "            pm.expect(referrerPolicy).to.include(\"strict-origin-when-cross-origin\");",
                  "            const contentSecurityPolicy = pm.response.headers.get(\"content-security-policy\");",
